<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:core="clr-namespace:MauiWeather.Presentation.Core;assembly=MauiWeather.Presentation">

    <!-- The app's design tokens and the styles built on them. Colours come
         from Colors.xaml; a number that only one view cares about is beside
         that view instead. -->

    <!-- The steps every gap and padding is taken from. -->
    <x:Double x:Key="SpaceXxs">2</x:Double>
    <x:Double x:Key="SpaceXs">4</x:Double>
    <x:Double x:Key="SpaceSm">8</x:Double>
    <x:Double x:Key="SpaceMd">12</x:Double>
    <x:Double x:Key="SpaceLg">16</x:Double>
    <x:Double x:Key="SpaceXl">24</x:Double>

    <!-- The least height and width Material asks of anything pressed. -->
    <x:Double x:Key="MinTouchTarget">48</x:Double>

    <!-- Corner radii, after Material 3's shape scale. -->
    <RoundRectangle x:Key="ShapeExtraSmall" CornerRadius="4" />
    <RoundRectangle x:Key="ShapeMedium" CornerRadius="12" />
    <RoundRectangle x:Key="ShapeExtraLarge" CornerRadius="28" />
    <RoundRectangle x:Key="ShapeSheet" CornerRadius="28,28,0,0" />

    <!-- Type, after Material 3's scale. Sizes follow the device's text size. -->
    <Style x:Key="Text" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style TargetType="Label" BasedOn="{StaticResource Text}" />
    <Style x:Key="DisplayMedium" TargetType="Label" BasedOn="{StaticResource Text}">
        <Setter Property="FontSize" Value="45" />
    </Style>
    <Style x:Key="HeadlineSmall" TargetType="Label" BasedOn="{StaticResource Text}">
        <Setter Property="FontSize" Value="24" />
    </Style>
    <Style x:Key="TitleMedium" TargetType="Label" BasedOn="{StaticResource Text}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style x:Key="BodyLarge" TargetType="Label" BasedOn="{StaticResource Text}">
        <Setter Property="FontSize" Value="16" />
    </Style>
    <Style x:Key="BodyMedium" TargetType="Label" BasedOn="{StaticResource Text}">
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="BodyMediumMuted" TargetType="Label" BasedOn="{StaticResource BodyMedium}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
    </Style>
    <Style x:Key="LabelMedium" TargetType="Label" BasedOn="{StaticResource Text}">
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="LabelSmall" TargetType="Label" BasedOn="{StaticResource Text}">
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- An icon: one character of the Material Icons font. A screen reader
         skips it; whatever it stands beside says what it means. -->
    <Style x:Key="Icon" TargetType="Label">
        <Setter Property="FontFamily" Value="{x:Static core:Glyphs.FontFamily}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAutoScalingEnabled" Value="False" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
        <Setter Property="AutomationProperties.IsInAccessibleTree" Value="False" />
    </Style>

    <!-- The forecast's surface, as a bottom sheet or a side panel. -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceContainerLowLight}, Dark={StaticResource SurfaceContainerLowDark}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Shadow">
            <Shadow Brush="Black" Opacity="0.3" Radius="6" Offset="0,1" />
        </Setter>
    </Style>

    <!-- The search bar and its results. -->
    <Style x:Key="SearchSurface" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceContainerHighLight}, Dark={StaticResource SurfaceContainerHighDark}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="{StaticResource ShapeExtraLarge}" />
        <Setter Property="Shadow">
            <Shadow Brush="Black" Opacity="0.3" Radius="8" Offset="0,2" />
        </Setter>
    </Style>

    <!-- A button with no outline: an icon, or a word such as "Try again". -->
    <Style x:Key="TextButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource MinTouchTarget}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource MinTouchTarget}" />
        <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
        <Setter Property="FontFamily" Value="{x:Static core:Glyphs.FontFamily}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAutoScalingEnabled" Value="False" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
    </Style>

    <!-- Material 3's tonal button. -->
    <Style x:Key="TonalButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SecondaryContainerLight}, Dark={StaticResource SecondaryContainerDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSecondaryContainerLight}, Dark={StaticResource OnSecondaryContainerDark}}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource MinTouchTarget}" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

    <!-- One half of the units choice. -->
    <Style x:Key="UnitsButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HeightRequest" Value="{StaticResource MinTouchTarget}" />
        <Setter Property="WidthRequest" Value="64" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
    </Style>

</ResourceDictionary>
