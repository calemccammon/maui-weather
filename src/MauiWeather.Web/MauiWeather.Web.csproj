<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- The same app in a browser: Blazor WebAssembly views over the view
       models the MAUI app uses. It builds to static files. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.15" PrivateAssets="all" />
    <!-- Fetches the libraries listed in libman.json into wwwroot/lib when the project is built. -->
    <PackageReference Include="Microsoft.Web.LibraryManager.Build" Version="3.0.114" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MauiWeather.Domain\MauiWeather.Domain.csproj" />
    <ProjectReference Include="..\MauiWeather.Data\MauiWeather.Data.csproj" />
    <ProjectReference Include="..\MauiWeather.Presentation\MauiWeather.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- A build input, not part of the site. -->
    <Content Update="libman.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MauiWeather.Tests" />
  </ItemGroup>

</Project>
