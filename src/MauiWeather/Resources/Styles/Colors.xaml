<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Every colour is derived from one seed, #2E6FB7, as Material 3 intends:
         these are the roles Material's "tonal spot" scheme gives for it, as
         generated by the Material Theme Builder
         (https://m3.material.io/theme-builder). Only the roles the app uses
         are listed; Styles.xaml pairs each light colour with its dark one. -->

    <Color x:Key="PrimaryLight">#3B608F</Color>
    <Color x:Key="OnPrimaryLight">#FFFFFF</Color>
    <Color x:Key="SecondaryContainerLight">#D8E3F8</Color>
    <Color x:Key="OnSecondaryContainerLight">#3D4758</Color>
    <Color x:Key="TertiaryLight">#6D5677</Color>
    <Color x:Key="ErrorLight">#BA1A1A</Color>
    <Color x:Key="SurfaceLight">#F8F9FF</Color>
    <Color x:Key="OnSurfaceLight">#191C20</Color>
    <Color x:Key="OnSurfaceVariantLight">#43474E</Color>
    <Color x:Key="OutlineLight">#73777F</Color>
    <Color x:Key="SurfaceContainerLowLight">#F2F3FA</Color>
    <Color x:Key="SurfaceContainerHighLight">#E7E8EE</Color>
    <Color x:Key="SurfaceContainerHighestLight">#E1E2E9</Color>

    <Color x:Key="PrimaryDark">#A4C9FE</Color>
    <Color x:Key="OnPrimaryDark">#00315D</Color>
    <Color x:Key="SecondaryContainerDark">#3D4758</Color>
    <Color x:Key="OnSecondaryContainerDark">#D8E3F8</Color>
    <Color x:Key="TertiaryDark">#D9BDE3</Color>
    <Color x:Key="ErrorDark">#FFB4AB</Color>
    <Color x:Key="SurfaceDark">#111318</Color>
    <Color x:Key="OnSurfaceDark">#E1E2E9</Color>
    <Color x:Key="OnSurfaceVariantDark">#C3C6CF</Color>
    <Color x:Key="OutlineDark">#8D9199</Color>
    <Color x:Key="SurfaceContainerLowDark">#191C20</Color>
    <Color x:Key="SurfaceContainerHighDark">#272A2F</Color>
    <Color x:Key="SurfaceContainerHighestDark">#32353A</Color>

</ResourceDictionary>
