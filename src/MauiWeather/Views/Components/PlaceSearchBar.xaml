<?xml version="1.0" encoding="utf-8" ?>
<!-- Material 3 search bar that opens into a list of matching places.

     Closed, it shows the selected place's name. Open, it holds what is being
     typed and shows what the search view model says under it. It does no
     searching of its own. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:core="clr-namespace:MauiWeather.Presentation.Core;assembly=MauiWeather.Presentation"
             xmlns:models="clr-namespace:MauiWeather.Presentation.Home.Models;assembly=MauiWeather.Presentation"
             xmlns:strings="clr-namespace:MauiWeather.Presentation.Resources;assembly=MauiWeather.Presentation"
             xmlns:viewModels="clr-namespace:MauiWeather.Presentation.Home.ViewModels;assembly=MauiWeather.Presentation"
             x:Class="MauiWeather.Views.Components.PlaceSearchBar"
             x:DataType="viewModels:SearchViewModel">
    <Border Style="{StaticResource SearchSurface}">
        <Grid RowDefinitions="56,Auto">

            <!-- Closed: the place's name, or the hint. Pressing it opens the search. -->
            <Grid x:Name="ClosedBar" ColumnDefinitions="Auto,*,Auto" Padding="16,0,4,0" ColumnSpacing="{StaticResource SpaceLg}">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBarTapped" />
                </Grid.GestureRecognizers>
                <Label Text="{x:Static core:Glyphs.Search}" Style="{StaticResource Icon}"
                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
                <Label x:Name="PlaceLabel" Grid.Column="1" Style="{StaticResource BodyLarge}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                <Label x:Name="HintLabel" Grid.Column="1"
                       Text="{x:Static strings:Strings.SearchHint}"
                       Style="{StaticResource BodyLarge}"
                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}"
                       VerticalOptions="Center" />
                <Button x:Name="ClearButton" Grid.Column="2"
                        Text="{x:Static core:Glyphs.Close}"
                        Style="{StaticResource IconButton}"
                        Clicked="OnClearClicked"
                        SemanticProperties.Description="{x:Static strings:Strings.ClearPlace}" />
            </Grid>

            <!-- Open: somewhere to type. -->
            <Grid x:Name="OpenBar" ColumnDefinitions="Auto,*" Padding="16,0,16,0" ColumnSpacing="{StaticResource SpaceLg}" IsVisible="False">
                <Label Text="{x:Static core:Glyphs.Search}" Style="{StaticResource Icon}"
                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
                <Entry x:Name="QueryEntry" Grid.Column="1"
                       Text="{Binding Query, Mode=TwoWay}"
                       Placeholder="{x:Static strings:Strings.SearchHint}"
                       PlaceholderColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}"
                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}"
                       FontSize="16"
                       ReturnType="Search"
                       IsSpellCheckEnabled="False"
                       IsTextPredictionEnabled="False"
                       VerticalOptions="Center" />
            </Grid>

            <!-- Under the open bar: searching, what was found, or why nothing was. -->
            <VerticalStackLayout x:Name="ResultsArea" Grid.Row="1" IsVisible="False">
                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />

                <ActivityIndicator IsVisible="{Binding IsSearching}"
                                   IsRunning="{Binding IsSearching}"
                                   HorizontalOptions="Center"
                                   Margin="0,16"
                                   SemanticProperties.Description="{x:Static strings:Strings.SearchSearching}" />

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpaceLg}" Padding="16,12,4,12" IsVisible="{Binding HasMessage}">
                    <Label Text="{Binding MessageIcon}" Style="{StaticResource Icon}" />
                    <Label Grid.Column="1"
                           Text="{Binding Message}"
                           Style="{StaticResource BodyLarge}"
                           TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}"
                           VerticalOptions="Center" />
                    <Button Grid.Column="2"
                            Text="{x:Static strings:Strings.TryAgain}"
                            Command="{Binding RetryCommand}"
                            IsVisible="{Binding HasFailed}"
                            Style="{StaticResource TextButton}" />
                </Grid>

                <ScrollView x:Name="ResultsScroll" IsVisible="{Binding HasResults}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Results}" Padding="0,0,0,8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:PlaceUiModel">
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource SpaceLg}" Padding="16,10" MinimumHeightRequest="56">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPlaceTapped" />
                                    </Grid.GestureRecognizers>
                                    <Label Grid.RowSpan="2" Text="{x:Static core:Glyphs.Place}" Style="{StaticResource Icon}" />
                                    <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource BodyLarge}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Grid.Row="1"
                                           Text="{Binding Subtitle}"
                                           IsVisible="{Binding HasSubtitle}"
                                           Style="{StaticResource BodyMediumMuted}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>
            </VerticalStackLayout>

        </Grid>
    </Border>
</ContentView>
